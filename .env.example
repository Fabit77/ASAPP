# Production: required. Use Supabase's transaction pooler with SSL.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# For private upload bucket access from the server only.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Local only; never enable on Vercel. Without DATABASE_URL local dev uses PGlite.
ASAPP_LOCAL_DEMO=true
# Demo pública efímera para previews sin Supabase. No usar con datos reales.
ASAPP_HOSTED_DEMO=false
